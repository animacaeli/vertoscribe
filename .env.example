# Vertoscribe 环境变量配置
# 复制此文件为 .env 并填入实际值

# DeepSeek API 密钥（必需）
DEEPSEEK_API_KEY=sk-your-key-here

# DashScope API 密钥（可选，仅 --with-vision 时需要）
DASHSCOPE_API_KEY=sk-your-key-here

# B站 Cookie（可选，大会员/付费视频时需要）
BILIBILI_COOKIE=""

# Whisper 模型选择（可选，默认 base）
# 可选: tiny / base / small / medium
WHISPER_MODEL=base
